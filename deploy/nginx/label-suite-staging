# Host-level Nginx（裝在 VM/主機上，不在 Compose stack 內）— staging 應用入口。
# 依 ADR-023：獨佔 80/443，依 server_name 路由到 Compose 綁定的 loopback 埠。
# 注意：Ubuntu 24.04 的 nginx 1.24 使用 `listen 443 ssl http2;`，不支援獨立的 `http2 on;`。

# HTTP → HTTPS 轉址
server {
    listen 80;
    server_name staging.label-suite.test;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name staging.label-suite.test;

    ssl_certificate     /etc/nginx/certs/staging.label-suite.test.pem;
    ssl_certificate_key /etc/nginx/certs/staging.label-suite.test-key.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # /metrics 不對外（ADR-023 路由契約）
    # return 在 rewrite 階段執行，早於 access 階段的 deny，故 deny all 永遠不會被觸及
    location /metrics {
        return 404;
    }
}
