# develop VM 部署演練用環境變數範本。
# 實際 .env 只存在於 VM 的 /data/label-suite/staging/compose/.env，不進版控。
# 密碼在 VM 內以 openssl rand 生成，見 docs/operations/deployment.md §6.2。
# 使用時複製為 .env：cp env.example .env

POSTGRES_DB=label_suite
POSTGRES_USER=label_suite
POSTGRES_PASSWORD=<openssl rand -hex 16>
GRAFANA_ADMIN_PASSWORD=<openssl rand -hex 12>
