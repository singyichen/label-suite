test-results/

# eslint-boundaries.test.ts fixtures — written under real src/features/ and
# src/shared/ trees to satisfy eslint-plugin-boundaries path resolution;
# normally cleaned up in afterEach, but an interrupted run can leave these on
# disk untracked.
frontend/src/features/__eslint_boundary_fixture*__/
frontend/src/shared/__eslint_boundary_fixture*__/

# Qodo code review bot working directory
.qodo/

# Serena MCP server project config (local dev environment)
.serena/

# Claude Code local settings (personal dev environment)
.claude/settings.local.json
# Audit log — tool invocation history, local only (post-incident analysis)
.claude/audit.log
# Multi-session task progress tracker (session-specific, not shared)
/claude-progress.md
# Per-sprint acceptance layer (generated per task, not shared)
/feature_list.json

# Prototype analytics local config (contains dev token)
design/prototype/assets/analytics.config.local.json
.worktrees/
