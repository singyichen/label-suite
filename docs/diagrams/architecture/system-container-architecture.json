  "cards": [
    {
      "dot": "cyan",
      "title": "執行與部署",
      "items": [
        "Cloudflare 與 Host-level Nginx 形成唯一公開入口；應用與資料服務不直接暴露於 Internet",
        "Frontend、Backend、Worker、資料層與監控棧由 Docker Compose 編排",
        "快速體驗可依 ADR-024 使用 SQLite；正式多人環境以 PostgreSQL 為準"
      ]
    },
    {
      "dot": "violet",
      "title": "非同步與資料邊界",
      "items": [
        "FastAPI 將耗時計分工作送入 Redis broker，Celery Worker 非同步處理",
        "Redis DB0 / DB1 / DB2 分別承擔 broker、result backend 與 application cache",
        "隱藏測試答案僅由 Worker 取用，不進入 annotator-facing API response"
      ]
    },
    {
      "dot": "emerald",
      "title": "外部服務與可觀測性",
      "items": [
        "Resend 僅由 Backend 呼叫，用於 transactional email",
        "Sentry 接收已清理的 Frontend、Backend 與 Worker 錯誤事件",
        "Prometheus 經應用 metrics 與 exporters 採集，Grafana 以 PromQL 呈現 dashboard"
      ]
    }
  ]
