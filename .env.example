# --- managed: backend Settings (backend/app/core/config.py) ---
# Keys below are owned by the backend Settings model and are checked for drift
# by backend/tests/test_env_example.py. Add or remove a key here only together
# with the matching field in app/core/config.py.

# Deployment environment. Any string is accepted; only "production" changes
# behavior (FR-021 / FR-070).
ENVIRONMENT=local

# CORS allow-list, comma-separated. Required — Settings has no default, so a
# missing value fails startup validation (FR-022). A wildcard "*" is rejected
# in every environment.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# SQLAlchemy async database URL. The SQLite default needs no running server.
# PostgreSQL requires the +asyncpg driver — a bare postgresql:// URL resolves
# to the sync psycopg2 driver, which the async engine cannot use.
DATABASE_URL=sqlite+aiosqlite:///./local.db

# Expose FastAPI /docs and /redoc. Defaults to true outside production and
# false in production; an explicit value always wins. Must not be left empty —
# an empty string fails bool parsing.
ENABLE_OPENAPI_DOCS=true
# --- end managed ---

# --- Reserved for not-yet-implemented modules ---
# Documented ahead of the code that reads them, and deliberately kept outside
# the managed section above so the drift check does not fail on keys Settings
# does not own yet. Several are already exported by .github/workflows/ci.yml.

# Database (test) / Celery broker
TEST_DATABASE_URL=
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=change-this-to-a-random-secret-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# App
DEBUG=true
